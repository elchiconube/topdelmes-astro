---
import { marked } from 'marked';

import { getAuthor } from '../../data/api';

import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ReviewList from '../../components/ReviewList.astro';

const { slug } = Astro.params;
const { author } = await getAuthor(slug);

const body = marked.parse(author.attributes.bio);
---

<Layout
  title={`Página de ${author.attributes.fullname} | TopDelMes`}
  description={`Página de ${author.attributes.fullname} | TopDelMes`}
  canonical={`https://topdelmes.com/autores/${author.attributes.slug}`}
>
  <Breadcrumb
    maxWidth={900}
    links={[
      { href: 'https://topdelmes.com/', name: 'Inicio' },
      { href: 'https://topdelmes.com/autores', name: 'Autores' },
      {
        href: `https://topdelmes.com/autores/${author.attributes.slug}`,
        name: author.attributes.fullname,
      },
    ]}
  />

  <div
    class={'section'}
    itemprop='author'
    itemscope
    itemtype='http://schema.org/Person'
  >
    <article>
      <figure>
        <img
          alt={author.attributes.fullname}
          src={author.attributes.avatar}
          width={120}
          height={120}
        />
      </figure>
      <h2 class={'subtitle'}>
        Periodista especialista en críticas de cine y series
      </h2>
      <h1 class={'title'}>{author.attributes.fullname}</h1>

      <div itemprop='articleBody' class='body' set:html={body} />
    </article>
  </div>
  <ReviewList items={author.attributes.reviews.data} />
</Layout>

<style>
  .section {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
    color: var(--gainsboro);
    font-size: var(--fs-7);
    padding: 32px;
    position: relative;
  }
  .section article {
    padding: 40px 0;
  }

  .section article img {
    border-radius: 50%;
    display: inline-block;
  }

  .title {
    text-align: center;
    font-size: var(--fs-1);
    color: var(--gainsboro);
    line-height: 1.2;
    margin-bottom: 18px;
  }
  .subtitle {
    color: var(--citrine);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
  }
  .body {
    text-align: left;
  }

  .body p {
    margin-bottom: 16px;
  }
</style>
