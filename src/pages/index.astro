---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import List from '../components/List.astro';
import ReviewList from '../components/ReviewList.astro';
import PreviousYears from '../components/PreviousYears.astro';
import Previous from '../components/Previous.astro';
import TimeMachine from '../components/TimeMachine.astro';
import Newsletter from '../components/Newsletter.astro';

import { getFullYear, getCurrentMonthName } from '../utils';

import { getHomeData } from '../data/api';

const year = getFullYear();
const month = getCurrentMonthName();

const data = await getHomeData();

const { seriesYear, moviesYear, reviews, seriesMonth, moviesMonth } = data;
---

<Layout>
  <Hero />
  <Newsletter />

  <section class={'section'}>
    <header>
      <p class={'subtitle'}>Las mejores series de {year}</p>
      <h2 class={'title'}>Top 10 de series de {year}</h2>
    </header>
    <div class={'description'}>
      <p>
        Nuestra lista de las mejores series del {year} se actualiza diariamente para
        que siempre estés al día de las últimos lanzamientos. Esperabas que apareciera
        una serie en nuestro top y no la ves? No te preocupes, averigua en qué posición
        está en nuestro{' '}
        <a href={`/series`}>ranking de series completo</a>
      </p>
    </div>
    <List items={seriesYear} dataprop='TVSeries' />
    <footer class={'section_footer'}>
      <a class={'cta'} href={`/series`}>
        Mejores series del año {year}
      </a>
    </footer>
  </section>

  <section class={'section'}>
    <header>
      <p class={'subtitle'}>
        Las películas mejor puntuadas durante el mes de {year}
      </p>
      <h2 class={'title'}>Top 10 de películas {year}</h2>
    </header>
    <div class={'description'}>
      <p>
        ¿Quieres saber cuáles son las mejores películas del {year}? En TopDelMes
        te lo ponemos fácil. Aquí tienes un listado con las 10 mejores películas
        del {year} actualizado diariamente. Además, podrás consultar{' '}
        <a href={`/peliculas`}>las mejores películas de {year}.</a>
      </p>
    </div>
    <List items={moviesYear} dataprop='Movie' />
    <footer class={'section_footer'}>
      <a class={'cta'} href={`/peliculas`}>
        Mejores películas del año {year}
      </a>
    </footer>
  </section>

  <section class={'section'}>
    <header>
      <p class={'subtitle'}>Últimos análisis del mes de {month}</p>
      <h2 class={'title'}>Análisis de las mejores películas y series</h2>
    </header>
    <ReviewList items={reviews} />
    <footer class={'section_footer'}>
      <a class={'cta'} href='/analisis'> Ver todos los análisis</a>
    </footer>
  </section>

  <section class={'section'}>
    <header>
      <p class={'subtitle'}>
        Las series estrenadas en {month}
        {year} mejor valoradas
      </p>
      <h2 class={'title'}>
        Mejores series {month}
        {year}
      </h2>
    </header>
    <div class={'description'}>
      <p>
        Aquí tienes un listado con las 10 mejores series estrenadas en{' '}
        {month}
        {year} actualizado diariamente. Esperabas que apareciera una serie en nuestro
        top y no la ves? No te preocupes, averigua en qué posición está en nuestro{
          ' '
        }
        <a href={`/mejores/series/${year}/${month}`}>
          ranking completo de {month}
          {year}
        </a>
      </p>
    </div>
    <List items={seriesMonth} dataprop='TVSeries' />
    <footer class={'section_footer'}>
      <a class={'cta'} href={`/mejores/series/${year}/${month}`}>
        Ver el top completo de {month}
        {year}
      </a>
    </footer>
  </section>

  <section class={'section'}>
    <header>
      <p class={'subtitle'}>
        Las películas estrenadas en {month}
        {year} mejor valoradas
      </p>
      <h2 class={'title'}>
        Mejores películas {month}
        {year}
      </h2>
    </header>
    <div class={'description'}>
      <p>
        ¿Quieres saber cuáles son los mejores películas estrenadas en
        {month}
        {year}? Aquí tienes un listado con las 10 mejores películas estrenadas
        en {month}
        {year} actualizado diariamente. Además, podrás consultar el{' '}
        <a href={'/mejores/peliculas'}>top de películas completo</a>.
      </p>
    </div>
    <List items={moviesMonth} dataprop='Movie' />
    <footer class={'section_footer'}>
      <a class={'cta'} href={`/mejores/peliculas/${year}`}>
        Mejores películas {month}
        {year}
      </a>
    </footer>
  </section>

  <PreviousYears />
  <Previous />
  <TimeMachine />
</Layout>

<style>
  .heading {
    text-align: center;
    font-size: var(--fs-1);
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .title {
    text-align: center;
    font-size: var(--fs-2);
    color: var(--white);
    line-height: 1.2;
  }

  .description {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
    color: var(--gainsboro);
    font-size: var(--fs-7);
    padding: 32px;
    position: relative;
  }

  .description a {
    color: var(--gainsboro);
    text-decoration: underline;
    font-size: var(--fs-7);
    transition: var(--transition-1);
    display: inline;
  }

  .description a:hover {
    color: var(--citrine);
    text-decoration: underline;
    font-size: var(--fs-7);
  }
  .subtitle {
    color: var(--citrine);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
  }

  .section {
    padding: 32px 0 0 0;
    border-top: 1px solid var(--gunmetal-2);
  }

  .section_footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding-bottom: 40px;
    gap: 16px;
    border-bottom: 1px solid var(--black);
  }

  .cta {
    color: var(--white);
    font-size: var(--fs-11);
    font-weight: var(--fw-700);
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    border: 2px solid var(--citrine);
    border-radius: 50px;
    transition: var(--transition-1);
  }

  .cta:hover {
    background: var(--citrine);
    color: var(--xiketic);
  }
</style>
