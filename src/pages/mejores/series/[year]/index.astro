---
import Layout from '../../../../layouts/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import List from '../../../../components/List.astro';
import { getAdjacentYears, isValidYear } from '../../../../utils';
import { getTopByYear } from '../../../../data/api';

const { year } = Astro.params;

const { next, prev } = getAdjacentYears(year, 'tv_series');

if (!isValidYear(year, 'tv_series')) {
  Astro.redirect('/no-hay-datos');
}

const { data } = await getTopByYear('tv_series', year);
---

<Layout
  title={`Top ${year}: Mejores Series | TopDelMes`}
  description={`Explora las mejores series de  ${year} en nuestra lista completa y actualizada en TopDelMes.com. ¡Encuentra tus series favoritas y descubre nuevas!`}
  canonical={`https://topdelmes.com/mejores/series/${year}`}
>
  <Breadcrumb
    maxWidth={'100%'}
    links={[
      {
        href: 'https://topdelmes.com/',
        name: 'Inicio',
      },
      {
        href: `https://topdelmes.com/mejores/series/${year}`,
        name: `Mejores series de ${year}`,
      },
    ]}
  />
  <div class={'section'} itemscope itemtype='http://schema.org/ItemList'>
    <h1 class={'title'}>Las mejores series de {year}</h1>
    <h2 class={'subtitle'}>
      Las series mejor puntuadas durante el {year}
    </h2>
    <p class={'description'}>
      Descubre las 50 series más populares y mejor valoradas y estrenadas en{
        ' '
      }
      {year}.
    </p>
    <p class={'description'}>
      En nuestra lista de las mejores series de {year}, encontrarás una amplia
      variedad de géneros y temáticas, desde dramas intensos hasta comedias
      ligeras, pasando por intrigantes series de ciencia ficción y apasionantes
      thrillers. Nuestro ranking se basa en las valoraciones y opiniones de los
      espectadores, lo que garantiza que solo encontrarás las series más
      populares y de mayor calidad.
    </p>
    <p class={'description'}>
      Si estás buscando nuevas series para ver o quieres saber cuáles son las
      más destacadas del año, nuestra lista de las mejores series de{' '}
      {year} es el recurso perfecto para ti. Explora nuestro ranking y descubre
      las series que están dando de qué hablar. ¡No esperes más y comienza a
      disfrutar de las mejores series del año!
    </p>
    <List items={data} dataprop='TVSeries' />
    <footer class={'footer'}>
      {
        prev && (
          <a href={`/mejores/series/${prev}`}>
            Ver mejores series estrenadas en {prev}
          </a>
        )
      }
      {
        next && (
          <a href={`/mejores/series/${next}`}>
            Ver mejores series estrenadas en {next}
          </a>
        )
      }
    </footer>
  </div>
</Layout>

<style>
  .title {
    text-align: center;
    font-size: var(--fs-2);
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .subtitle {
    color: var(--citrine);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    text-align: center;
  }
  .section {
    padding: 32px 0 0 0;
  }

  .description {
    padding: 0 32px;
    font-size: var(--fs-13);
    font-weight: var(--fw-500);
    color: var(--white);
    max-width: 900px;
    margin: 0 auto 25px;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-bottom: 32px;
  }

  .footer a {
    color: var(--white);
    font-size: var(--fs-11);
    font-weight: var(--fw-700);
    text-transform: uppercase;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    border: 2px solid var(--citrine);
    border-radius: 50px;
    transition: var(--transition-1);
  }

  .footer a:hover {
    background: var(--citrine);
    color: var(--xiketic);
  }
</style>
