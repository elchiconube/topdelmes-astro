---
import Layout from '../../layouts/Layout.astro';
import ReviewList from '../../components/ReviewList.astro';
import Pagination from '../../components/Pagination.astro';

import { getReviews } from '../../data/api';
import Newsletter from '../../components/Newsletter.astro';

const page = Astro.url.searchParams.get('page')! || '';

const { reviews, pagination } = await getReviews(page);
---

<Layout
  title={`Análisis de Series y Películas | TopDelMes`}
  description={`Descubre análisis detallados e imparciales de tus películas y series favoritas en TopDelMes. Nuestros expertos te ofrecen opiniones y calificaciones para ayudarte a elegir qué ver.`}
  canonical={`https://topdelmes.com/analisis`}
>
  <div itemscope itemtype='http://schema.org/ItemList'>
    <header>
      <h1 class={'title'}>Análisis de Películas y Series</h1>
      <h2 class={'subtitle'}>
        Opiniones y calificaciones de expertos para tus películas y series
        favoritas
      </h2>
      <p class={'description'}>
        En TopDelMes, analizamos las <strong>películas y series</strong> más populares
        y mejor puntuadas para que puedas tomar decisiones informadas sobre qué ver.
        Nuestros expertos te ofrecen opiniones detalladas e imparciales, así como
        calificaciones basadas en diversos factores. Explora nuestra selección de
        análisis y descubre tus próximos favoritos.
      </p>
    </header>
    <Newsletter />

    <ReviewList items={reviews} />
    <Pagination pagination={pagination} />
  </div>
  <Newsletter />
</Layout>
<style>
  div {
    padding: 32px;
  }

  header {
    text-align: center;
  }

  .title {
    text-align: center;
    font-size: var(--fs-2);
    color: var(--white);
    line-height: 1.2;
  }

  .subtitle {
    color: var(--citrine);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: center;
  }

  .description {
    max-width: 900px;
    text-align: center;
    margin: 0 auto;
    color: var(--gainsboro);
    font-size: var(--fs-7);
    padding: 32px;
    position: relative;
  }
</style>
