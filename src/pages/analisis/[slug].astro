---
import { marked } from 'marked';

import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ReviewFooter from '../../components/ReviewFooter.astro';
import YoutubeVideo from '../../components/YoutubeVideo.astro';
import SocialHead from '../../components/SocialHead.astro';

import { getReview } from '../../data/api';
import { postFormatDate } from '../../utils';

const { slug } = Astro.params;

if (!slug) return null;

const { review } = await getReview(slug);

const {
  title,
  trailer,
  body,
  image,
  publishedAt,
  director,
  updatedAt,
  author,
  contents,
  rate,
} = review.attributes;

const relatedContent =
  contents.data.length > 0 ? contents.data[0].attributes : null;
const articleAuthor = author.data.attributes;

const breadCrumbTitle = relatedContent ? relatedContent.title : title;
---

<Layout
  title={`Análisis de ${title} | TopDelMes`}
  description={`Descubre el análisis de ${title}. Lee nuestra crítica detallada y entérate de por qué no te puedes perder.`}
  canonical={`https://topdelmes.com/analisis/${slug}`}
>
  <SocialHead title={title} slug={slug} image={image} slot='social' />

  <Breadcrumb
    maxWidth={'100%'}
    links={[
      {
        href: 'https://topdelmes.com/',
        name: 'Inicio',
      },
      {
        href: 'https://topdelmes.com/analisis',
        name: 'Análisis',
      },
      {
        href: `https://topdelmes.com/analisis/${slug}`,
        name: breadCrumbTitle,
      },
    ]}
  />

  <article class={'article'} itemscope itemtype='http://schema.org/Article'>
    <h1 itemprop='headline'>{title}</h1>
    <div class={'pre'}>
      <address
        class={'author'}
        itemprop='author'
        itemscope
        itemtype='http://schema.org/Person'
      >
        {
          articleAuthor ? (
            <a itemprop='url' href={`/autores/${articleAuthor.slug}`}>
              <figure class={'avatar'}>
                <img
                  src={articleAuthor.avatar}
                  width={70}
                  height={70}
                  alt={`Avatar de ${articleAuthor.fullname}`}
                />
              </figure>
              <span itemprop='name'>{articleAuthor.fullname}</span>
            </a>
          ) : (
            <span itemprop='name'>TopDelMes</span>
          )
        }
      </address>
      <time datetime={publishedAt} itemprop='datePublished'>
        {postFormatDate(publishedAt)}
      </time>
      <meta datetime={updatedAt} itemprop='dateModified' />
    </div>
    {
      image ? (
        <figure class={'figure'}>
          <img
            itemprop='image'
            src={image || '/images/popcorn.webp'}
            width={862}
            height={465}
            alt={`Análisis ${title}`}
          />
        </figure>
      ) : null
    }

    <div class={'data'}>
      <!-- <Rating rating={rate} /> -->
      <h3>Nota</h3>
      <p><strong>{rate || 6}</strong><small>/10</small></p>
    </div>

    <div itemprop='articleBody' class='body' set:html={marked.parse(body)} />

    <p class={'actions'}>
      <a href={'/analisis'} class={'cta'} title={'Accede a todos los análisis'}>
        Ver más análisis
      </a>
    </p>
    {trailer && <YoutubeVideo url={trailer} />}
  </article>

  {
    relatedContent && (
      <ReviewFooter
        relatedContent={relatedContent}
        director={director}
        articleAuthor={articleAuthor}
        rate={rate}
        body={body}
      />
    )
  }
</Layout>
<style is:inline>
  .article h1 {
    color: var(--white);
    font-size: var(--fs-1);
    transition: var(--transition-1);
    padding: 0 16px;
    max-width: 700px;
    margin: 12px auto 32px;
    line-height: 1.3;
  }

  .pre {
    max-width: 700px;
    padding: 0 16px;
    margin: 0px auto;
    color: var(--gainsboro);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .author a {
    color: var(--citrine);
    display: flex;
    align-items: center;
    gap: 8px;
    font-style: normal;
  }

  .author a figure {
    border-radius: 50%;
    overflow: hidden;
  }

  .figure {
    text-align: center;
    position: relative;
    background: var(--gunmetal-1);
    overflow: hidden;
    display: block;
    margin: 32px 0;
  }

  .figure img {
    display: inline-block;
    margin: 21px 0;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .body {
    max-width: 700px;
    padding: 0 16px;
    margin: 0px auto 60px;
    color: var(--gainsboro);
  }

  .data {
    text-align: center;
    position: relative;
    display: block;
    margin: 18px auto;
    width: 120px;
    line-height: 1;
    h3 {
      margin: 0;
      font-weight: normal;
    }
    p {
      color: var(--citrine);
      strong {
        font-size: 60px;
      }

      small {
        font-size: 15px;
        color: white;
        position: absolute;
        bottom: 0px;
        right: 14px;
        letter-spacing: 2px;
      }
    }
  }

  .body h2 {
    margin-bottom: 8px;
  }

  .body p {
    margin-bottom: 32px;
    line-height: 1.8;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-bottom: 16px;
  }

  .cta {
    color: var(--white);
    font-size: var(--fs-11);
    font-weight: var(--fw-700);
    text-transform: uppercase;
    letter-spacing: 2px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    border: 2px solid var(--citrine);
    border-radius: 50px;
    transition: var(--transition-1);
  }

  .cta:hover {
    background: var(--citrine);
    color: var(--xiketic);
  }
</style>
