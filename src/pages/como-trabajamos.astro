    h1 {
      color: var(--white);
      font-size: var(--fs-1);
      transition: var(--transition-1);
      padding: 0 16px;
      margin: 12px 0 32px;
    }

    h2 {
      margin-bottom: 14px;
    }

    ul {
      padding-left: 16px;
      margin-bottom: 24px;
    }
  }
</style>
