---
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/700.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { getFullYear, getCurrentMonthName } from '../utils';

import '../styles/main.css';

const year = getFullYear();
const month = getCurrentMonthName();

const {
  title = `Las Mejores Series y Las Mejores Películas ${year} - Actualizado en ${month} | TopDelMes`,
  description = `Descubre nuestra selección actualizada de las 10 mejores series y películas de ${month} ${year}. No te pierdas nuestras series recomendadas`,
  canonical = 'https://topdelmes.com',
} = Astro.props;
---

<html lang='es'>
  <head>
    <script async src='https://www.googletagmanager.com/gtag/js?id=G-NP9L1106X4'
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-NP9L1106X4');
    </script>

    <meta charset='utf-8' />

    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <link rel='canonical' href={canonical} />
    <link rel='icon' href='/favicon/favicon.ico' type='image/x-icon' />
    <link
      rel='apple-touch-icon'
      sizes='180x180'
      href='/favicon/apple-touch-icon.png'
    />
    <link
      rel='icon'
      type='image/png'
      sizes='32x32'
      href='/favicon/favicon-32x32.png'
    />
    <link
      rel='icon'
      type='image/png'
      sizes='16x16'
      href='/favicon/favicon-16x16.png'
    />

    <meta name='apple-mobile-web-app-title' content='topdelmes.com' />
    <meta name='application-name' content='topdelmes.com' />
    <meta name='theme-color' content='#171d21' />
    <title>{title || `${title} | Topdelmes`}</title>
    <meta name='description' content={description} />

    <slot name='social' />
    <script src='https://unpkg.com/@phosphor-icons/web' defer></script>

    <script type='application/ld+json'>
      {
        "@context": "http://schema.org",
        "@type": "NewsMediaOrganization",
        "name": "TopDelMes",
        "foundingDate": "2023",
        "missionCoveragePrioritiesPolicy": "https://www.topdelmes.com/como-trabajamos#mision",
        "ethicsPolicy": "https://www.topdelmes.com/como-trabajamos#codigo-conducta",
        "verificationFactCheckingPolicy": "https://www.topdelmes.com/como-trabajamos#verificacion",
        "unnamedSourcesPolicy": "https://www.topdelmes.com/como-trabajamos#fuentes-anonimas",
        "correctionsPolicy": "https://www.topdelmes.com/como-trabajamos#correciones",
        "noBylinesPolicy": "https://www.topdelmes.com/como-trabajamos#firmas",
        "actionableFeedbackPolicy": "https://www.topdelmes.com/como-trabajamos#lectores",
        "diversityPolicy": "https://www.topdelmes.com/como-trabajamos#diversidad",
        "diversityStaffingReport": "https://www.topdelmes.com/como-trabajamos#diversidad",
        "masthead": "https://www.topdelmes.com/como-trabajamos#estructura",
        "ownershipFundingInfo": "https://www.topdelmes.com/como-trabajamos#codigo-conducta",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "contact",
          "email": "info@topdelmes.com"
        },
        "address": {
          "@type": "PostalAddress",
          "telephone": "649131791",
          "email": "info@topdelmes.com",
          "addressLocality": "Leon",
          "postalCode": "24460",
          "streetAddress": "Principe de Asturias 6",
          "url": "https://www.topdelmes.com/",
          "sameAs": ["https://twitter.com/topdelmes_"]
        }
      }
    </script>
  </head>
  <body>
    <div class='layout'>
      <Header />
      <main class='main'>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main {
    flex-grow: 1;
    padding-top: 65px;
  }
</style>
