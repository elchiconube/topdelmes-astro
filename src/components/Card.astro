---
const { item, ranking } = Astro.props;

import { formatVotes, getToday } from '../utils';

const { title, poster, pub_year, metascore, imdb, votes, runtime, reviews } =
  item.attributes;

const { updatedAt } = item;
---

<div class={'container'} data-ranking={ranking}>
  <figure class={'figure'}>
    <img
      loading='lazy'
      itemprop='image'
      class={'poster'}
      src={poster}
      alt={`${title} Cartel`}
      width={280}
      height={415}
    />
  </figure>
  <div class={'header'}>
    <h3 itemprop='name'>{title}</h3>
  </div>
  <footer class={'footer'}>
    <div class={'data'}>
      <time class={'time'} datetime={pub_year}>
        {pub_year}
      </time>

      {
        runtime && runtime !== 0 && (
          <p>
            <i class='ph ph-clock' style={{ color: '#e2d703' }} /> {runtime}{' '}
            min.
            {runtime} min.
          </p>
        )
      }
    </div>
    {
      metascore && (
        <div class={'data'}>
          <p>
            <img
              src={'/images/metascore-logo.png'}
              width={16}
              height={16}
              alt='Metascore Logo'
            />
            Metascore
          </p>
          <p>Nota: {metascore}</p>
        </div>
      )
    }

    {
      imdb && (
        <div class={'data'}>
          <p>
            <img
              src={'/images/imdb-logo.png'}
              width={21}
              height={21}
              alt='IMDB Logo'
            />
            IMDB
          </p>
          <p>
            Votos: {formatVotes(votes)} - Nota: {imdb}
          </p>
        </div>
      )
    }
    {
      reviews?.data?.length > 0
        ? reviews.data.map((review) => (
            <a class={'link'} href={`/analisis/${review.attributes.slug}`}>
              Leer análisis: {review.attributes.rate || 6}/10
            </a>
          ))
        : null
    }
  </footer>
</div>

<style>
  .container {
    position: relative;
  }

  .container::before {
    content: attr(data-ranking);
    position: absolute;
    top: -16px;
    z-index: 1;
    font-size: 84px;
    font-weight: bold;
    left: -15px;
    color: var(--citrine);
    line-height: 1;
    text-shadow:
      -2px -2px 0 var(--eerie-black),
      2px -2px 0 var(--eerie-black),
      -2px 2px 0 var(--eerie-black),
      6px 6px 0 var(--eerie-black);
  }

  .figure {
    position: relative;
    background: var(--gunmetal-1);
    aspect-ratio: 2 / 3;
    border-radius: 6px;
    overflow: hidden;
    transition: var(--transition-1);
  }

  .poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: top;
  }

  .header h3 {
    color: var(--white);
    font-size: var(--fs-7);
    transition: var(--transition-1);
  }

  .time {
    color: var(--citrine);
    font-size: var(--fs-9);
    font-weight: var(--fw-500);
    white-space: nowrap;
    position: relative;
    top: 2px;
  }

  .link {
    color: var(--white);
    font-size: var(--fs-11);
    font-weight: var(--fw-700);
    text-transform: uppercase;
    white-space: nowrap;
    border: 2px solid var(--citrine);
    text-align: center;
    border-radius: 6px;
    padding: 10px 8px;
    transition: all 300ms ease-in-out;
  }

  .link:hover {
    color: var(--gunmetal-1);
    background-color: var(--citrine);
    border-color: var(--citrine);
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 9px;
  }

  .data > p {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--gainsboro);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
  }

  .data {
    color: var(--white);
    font-size: var(--fs-9);
    font-weight: var(--fw-500);
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: space-between;
  }

  .center {
    text-align: center;

    color: var(--gainsboro);
    font-size: var(--fs-11);
    font-weight: var(--fw-500);
  }
</style>
