---
const { pagination } = Astro.props;

if (!pagination) return null;
---

<div class={'pagination'}>
  {
    pagination.page > 1 && (
      <a
        href={`/analisis?page=${pagination.page - 1}`}
        class={'pagination_text'}
      >
        Anterior
      </a>
    )
  }
  {
    Array.from(Array(pagination.pageCount).keys()).map((_, i) => {
      const count = i + 1;
      return pagination.page === count ? (
        <i class={'pagination_current'}>{count}</i>
      ) : (
        <a class={'pagination_link'} href={`/analisis?page=${i + 1}`}>
          {i + 1}
        </a>
      );
    })
  }
  {
    pagination.page < pagination.pageCount && (
      <a
        href={`/analisis?page=${pagination.page + 1}`}
        class={'pagination_text'}
      >
        Siguiente
      </a>
    )
  }
</div>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 40px 0;
    gap: 20px;
    color: white;
  }
  .pagination_text {
    color: white;
    font-weight: var(--fw-500);
    font-size: var(--fs-13);
  }

  .pagination_text:hover {
    color: var(--citrine);
    text-decoration: underline;
  }

  .pagination_current {
    color: white;
  }

  .pagination_link {
    color: var(--eerie-black);
    background-color: var(--citrine);
    width: 24px;
    height: 24px;
    text-align: center;
    border-radius: 50%;
    font-weight: var(--fw-500);
  }
</style>
