---
import { getFullYear } from '../utils.js';

const year = getFullYear();
---

<footer class='footer'>
  <div class='container'>
    <div>
      <h4 class='heading'>Navegación</h4>
      <ul class='list'>
        <li><a class='link' href='/'>Inicio</a></li>
        <li><a class='link' href='/series'>Series</a></li>
        <li><a class='link' href='/peliculas'>Películas</a></li>
        <li><a class='link' href='/analisis'>Análisis</a></li>
        <li><a class='link' href='/autores'>Autores</a></li>
      </ul>
    </div>
  </div>
  <div class='copyright'>© {year} topdelmes.com</div>
</footer>

<style>
  .footer {
    background: var(--raisin-black);
    color: var(--white);
    padding: 32px 0 0;
  }

  .container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .heading {
    font-size: 24px;
    margin-bottom: 16px;
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link {
    color: var(--white);
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
  }

  .link:hover {
    color: var(--citrine);
  }

  .copyright {
    background: var(--rich-black-fogra-39);
    text-align: center;
    font-size: 14px;
    margin-top: 16px;
    padding: 16px 0;
  }
</style>
