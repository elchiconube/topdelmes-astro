---
import { limitBreadcrumb } from '../utils';

const { links = [], maxWidth = 700 } = Astro.props;
---

<nav class={'breadcrumb'}>
  <ol
    itemscope
    itemtype='http://schema.org/BreadcrumbList'
    style={{ maxWidth }}
  >
    {
      links.map((link, index) => (
        <>
          <li
            itemprop='itemListElement'
            itemscope
            itemtype='http://schema.org/ListItem'
          >
            <a itemprop='item' href={link.href} title={link.name}>
              <span>{limitBreadcrumb(link.name)}</span>
            </a>
            <meta itemprop='name' content={link.name} />
            <meta itemprop='position' content={index + 1} />
          </li>
          {index < links.length - 1 && <>»</>}
        </>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 32px 16px 0;
    margin: 0px auto;
    max-width: 700px;
    color: var(--gainsboro);
    font-size: var(--fs-8);
    white-space: nowrap;
  }

  .breadcrumb a {
    color: var(--gainsboro);
    transition: var(--transition-1);
  }

  .breadcrumb a:hover {
    color: var(--citrine);
  }
</style>
